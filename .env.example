# Copy this file to .env and fill in your values
# Never commit .env to git

PETKIT_USERNAME=your_email@example.com
PETKIT_PASSWORD=your_password
PETKIT_REGION=AU
PETKIT_TIMEZONE=Australia/Sydney

PETKIT_MQTT_HOST=localhost
PETKIT_MQTT_PORT=1883
PETKIT_TRACKED_PETS=Cookie,Mila

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=slm-dev-token-change-in-production
INFLUXDB_ORG=smart-litter
INFLUXDB_BUCKET=litter_monitor

# Dashboard credentials (dev defaults — change in production)
GRAFANA_ADMIN_PASSWORD=smartlitter123
INFLUXDB_ADMIN_PASSWORD=smartlitter123

# Node-RED credential encryption key (must be the same on all machines)
NODE_RED_CREDENTIAL_SECRET=slm-dev-credential-secret
